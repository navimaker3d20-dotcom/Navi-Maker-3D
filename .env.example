# ── Base de datos ────────────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:password@host:5432/navimaker3d"
# Solo necesaria si tu proveedor separa conexión pooled vs directa (Neon, Supabase).
# Si no aplica, usa el mismo valor que DATABASE_URL.
DIRECT_URL="postgresql://usuario:password@host:5432/navimaker3d"

# ── Auth.js (NextAuth) ───────────────────────────────────────────────
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Mercado Pago ─────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
# Secreto de firma del webhook (Mercado Pago > tus integraciones > webhooks)
MERCADOPAGO_WEBHOOK_SECRET=""

# ── Google Analytics 4 ───────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=""
# Admin > Flujos de datos > tu stream > Measurement Protocol API secrets
GA_API_SECRET=""

# ── Chatbot (OpenAI) ─────────────────────────────────────────────────
OPENAI_API_KEY=""
# Número de WhatsApp para escalar del chatbot a un asesor humano (formato: 521XXXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# ── Emails transaccionales (Resend) ──────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Navi Maker 3D <no-reply@navimaker3d.com>"

# ── Almacenamiento de imágenes (Cloudinary) ──────────────────────────
# Usado por /api/admin/uploads/signature para subir imágenes de productos y diseños.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Rate limiting (Upstash Redis) ────────────────────────────────────
# Si se dejan vacías, el rate limiting queda deshabilitado (no rompe la app).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
